<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaInstaller.ViewModels"
        xmlns:conv="using:AvaInstaller.Converters"
        xmlns:pageVm="using:AvaInstaller.ViewModels.Pages"
        xmlns:pages="using:AvaInstaller.Views.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="960"
        d:DesignHeight="640"
        Width="960"
        Height="640"
        MinWidth="960"
        MinHeight="640"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        x:Class="AvaInstaller.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="Ava Industrial Suite Setup"
        Background="#CBD5E1"
        FontFamily="Inter, Segoe UI">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:StateVisibilityConverter x:Key="StateVisibilityConverter" />
    </Window.Resources>

    <Window.DataTemplates>
        <DataTemplate DataType="pageVm:WelcomePageViewModel">
            <pages:WelcomePage />
        </DataTemplate>
        <DataTemplate DataType="pageVm:PathPageViewModel">
            <pages:PathPage />
        </DataTemplate>
        <DataTemplate DataType="pageVm:InstallingPageViewModel">
            <pages:InstallingPage />
        </DataTemplate>
        <DataTemplate DataType="pageVm:CompletedPageViewModel">
            <pages:CompletedPage />
        </DataTemplate>
        <DataTemplate DataType="pageVm:InstalledPageViewModel">
            <pages:InstalledPage />
        </DataTemplate>
        <DataTemplate DataType="pageVm:UninstallConfirmPageViewModel">
            <pages:UninstallConfirmPage />
        </DataTemplate>
        <DataTemplate DataType="pageVm:UninstallProgressPageViewModel">
            <pages:UninstallProgressPage />
        </DataTemplate>
        <DataTemplate DataType="pageVm:UninstallCompletePageViewModel">
            <pages:UninstallCompletePage />
        </DataTemplate>
    </Window.DataTemplates>


    <Border Margin="0"
            Background="#FFFFFF"
            BorderBrush="#CBD5E1"
            BorderThickness="1">
        <Grid RowDefinitions="80,*,Auto,64">
            <Border Background="#00264C"
                    BorderBrush="#155E75"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" Margin="28,0">
                    <StackPanel Orientation="Horizontal"
                                Spacing="12"
                                VerticalAlignment="Center">
                        <Border Width="34"
                                Height="34"
                                CornerRadius="4"
                                Background="#00828C"
                                BorderBrush="#42D7DE"
                                BorderThickness="1">
                            <TextBlock Text="A"
                                       Foreground="#FFFFFF"
                                       FontSize="19"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Ava Industrial Suite"
                                       Foreground="#FFFFFF"
                                       FontSize="20"
                                       FontWeight="Bold" />
                            <TextBlock Text="Setup deployment console"
                                       Foreground="#B6C8D3"
                                       FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1"
                            VerticalAlignment="Center"
                            Background="#001D3A"
                            CornerRadius="3"
                            Padding="9,5">
                        <TextBlock Text="v1.0.0"
                                   Foreground="#CBD5E1"
                                   FontSize="11"
                                   FontFamily="Consolas" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ColumnDefinitions="240,*">
                <Border Background="#F1F5F9"
                        BorderBrush="#D8E1E7"
                        BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*" Margin="0,28,0,0">
                        <StackPanel Margin="24,0,24,26" Spacing="4">
                            <TextBlock Text="Setup Wizard"
                                       Foreground="#00264C"
                                       FontSize="16"
                                       FontWeight="Bold" />
                            <TextBlock Text="Installation progress"
                                       Foreground="#64748B"
                                       FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Border Classes="StepItem active"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Welcome}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot active">
                                        <TextBlock Classes="StepNumber active" Text="1" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel active" Text="Welcome" />
                                </Grid>
                            </Border>
                            <Border Classes="StepItem inactive"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=!Welcome}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot inactive">
                                        <TextBlock Classes="StepNumber inactive" Text="1" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel inactive" Text="Welcome" />
                                </Grid>
                            </Border>

                            <Border Classes="StepItem active"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Path}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot active">
                                        <TextBlock Classes="StepNumber active" Text="2" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel active" Text="Install folder" />
                                </Grid>
                            </Border>
                            <Border Classes="StepItem inactive"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=!Path}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot inactive">
                                        <TextBlock Classes="StepNumber inactive" Text="2" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel inactive" Text="Install folder" />
                                </Grid>
                            </Border>

                            <Border Classes="StepItem active"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Installing}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot active">
                                        <TextBlock Classes="StepNumber active" Text="3" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel active" Text="Installing" />
                                </Grid>
                            </Border>
                            <Border Classes="StepItem inactive"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=!Installing}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot inactive">
                                        <TextBlock Classes="StepNumber inactive" Text="3" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel inactive" Text="Installing" />
                                </Grid>
                            </Border>

                            <Border Classes="StepItem active"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Completed}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot active">
                                        <TextBlock Classes="StepNumber active" Text="4" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel active" Text="Completed" />
                                </Grid>
                            </Border>
                            <Border Classes="StepItem inactive"
                                    IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=!Completed}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="12">
                                    <Border Classes="StepDot inactive">
                                        <TextBlock Classes="StepNumber inactive" Text="4" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="StepLabel inactive" Text="Completed" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="#FFFFFF">
                    <ContentControl Content="{Binding ActivePage}"
                                    Margin="34,30" />
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    Classes="TipDock"
                    IsVisible="{Binding HasError}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="12"
                            Background="#E05A47"
                            VerticalAlignment="Center">
                        <TextBlock Text="!"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <TextBlock Text="Warning / Error"
                                   Foreground="#8B2F22"
                                   FontSize="11"
                                   FontWeight="Bold" />
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#6F2A1F"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   MaxLines="2" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Classes="tipClose"
                            Content="×"
                            Command="{Binding ClearErrorCommand}" />
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="#F8FAFC"
                    BorderBrush="#D8E1E7"
                    BorderThickness="0,1,0,0"
                    Padding="28,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="BOOTSTRAPPER MODE / EXTERNAL PAYLOAD"
                               Foreground="#64748B"
                               FontSize="11"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Welcome}" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Path}" />
                        <Button Content="Back"
                                Command="{Binding BackCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Path}" />
                        <Button Content="Next"
                                Classes="primary"
                                Command="{Binding NextCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Welcome}" />
                        <Button Content="Install"
                                Classes="primary"
                                Command="{Binding InstallCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Path}" />
                        <Button Content="Finish"
                                Classes="primary"
                                Command="{Binding FinishCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Completed}" />
                        <Button Content="Upgrade"
                                Command="{Binding UpgradeCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Installed}" />
                        <Button Content="Repair"
                                Command="{Binding RepairCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Installed}" />
                        <Button Content="Uninstall"
                                Classes="danger"
                                Command="{Binding ShowUninstallCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Installed}" />
                        <Button Content="Close"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=Installed}" />
                        <Button Content="Uninstall"
                                Classes="danger"
                                Command="{Binding StartUninstallCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=UninstallConfirm}" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=UninstallConfirm}" />
                        <Button Content="Close"
                                Classes="primary"
                                Command="{Binding CancelCommand}"
                                IsVisible="{Binding CurrentPage, Converter={StaticResource StateVisibilityConverter}, ConverterParameter=UninstallComplete}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
